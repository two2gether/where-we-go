# WhereWeGo 로컬 개발 환경변수 설정 예시
# 이 파일을 복사해서 .env 파일을 만들어 사용하세요

# ====== 필수 설정 ======

# JWT 설정 (보안상 32자 이상 권장)
JWT_SECRET_KEY=dev-jwt-secret-key-for-local-development-minimum-32-chars

# Google Maps API (필수)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ====== 데이터베이스 설정 ======

# Docker Compose 사용시 (권장)
DB_URL=jdbc:mysql://localhost:3307/wherewego?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=wherewego
DB_PASSWORD=1234

# H2 인메모리 DB 사용시 (테스트용)
# DB_URL=jdbc:h2:mem:testdb;MODE=MySQL;DATABASE_TO_LOWER=TRUE
# DB_USERNAME=sa
# DB_PASSWORD=

# ====== 소셜 로그인 설정 ======

# 카카오 OAuth
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_REDIRECT_URI=http://localhost:8080/api/auth/kakao/callback

# 구글 OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# ====== 외부 서비스 설정 ======

# Toss Payments (결제 기능)
# 토스페이먼츠 테스트 환경 시크릿 키 (실제 결제 불가)
TOSS_SECRET_KEY=test_sk_zXLkKEypNArWmo50nX3lmeaxYG5R

# AWS S3 (이미지 업로드, 선택사항)
AWS_S3_IMAGES_BUCKET=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# ====== 개발 환경 설정 ======

# Redis (Docker Compose에서 자동 설정됨)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# 로그 레벨
# LOGGING_LEVEL_ROOT=INFO
# LOGGING_LEVEL_COM_EXAMPLE_WHEREWEGO=DEBUG