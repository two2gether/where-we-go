# Database Configuration
# 로컬 개발용 H2 (권장)
DB_URL=jdbc:h2:mem:testdb;MODE=MySQL;DATABASE_TO_LOWER=TRUE
DB_USERNAME=sa
DB_PASSWORD=

# 또는 실제 MySQL 사용시 (선택사항)
# DB_URL=jdbc:mysql://your-rds-endpoint:3306/wherewego?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
# DB_USERNAME=your-db-username
# DB_PASSWORD=your-db-password

# JWT Configuration
JWT_SECRET_KEY=dev-jwt-secret-key-for-local-development-only

# Google Maps API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Kakao OAuth (로컬 개발용)
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback

# Google OAuth (로컬 개발용)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Toss Payments
TOSS_SECRET_KEY=your-toss-secret-key