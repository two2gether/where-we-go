# API 설정 - 개발 환경 (ALB 기반)
VITE_API_BASE_URL=http://wherewego-prod-alb-1343640395.ap-northeast-2.elb.amazonaws.com/api

# Google Maps API
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# 파일 업로드 설정
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# 기타 설정
VITE_APP_NAME=Where We Go
VITE_APP_VERSION=1.0.0

# 개발 환경 디버깅
VITE_DEBUG=true