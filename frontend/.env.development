# 로컬 개발 환경 설정 (Docker Compose 사용)
VITE_API_BASE_URL=http://localhost:8080/api

# 토스 결제 콜백 URL - 백엔드 ALB 주소 (운영환경에서는 GitHub Secrets로 관리)
# 개발환경에서는 Docker Compose의 백엔드 주소 사용
VITE_PAYMENT_CALLBACK_URL=http://localhost:8080/api/payments/callback

# Google Maps API
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# 파일 업로드 설정
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# 기타 설정
VITE_APP_NAME=Where We Go
VITE_APP_VERSION=1.0.0

# 개발 환경 디버깅
VITE_DEBUG=true
VITE_LOG_LEVEL=debug

# 로컬 개발 모드
VITE_ENVIRONMENT=local