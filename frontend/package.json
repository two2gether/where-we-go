{
  "name": "where-we-go-frontend",
  "version": "1.0.1",
  "description": "Where We Go - 여행 코스 공유 플랫폼 프론트엔드",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "npm run env:local && vite",
    "dev:aws": "npm run env:aws && vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "env:local": "node scripts/switch-env.js local",
    "env:aws": "node scripts/switch-env.js aws",
    "docker:up": "cd .. && docker-compose up -d mysql redis && echo 'MySQL, Redis 컨테이너가 시작되었습니다. 백엔드를 ./gradlew bootRun으로 실행하거나 docker-compose up app을 사용하세요.'",
    "docker:down": "cd .. && docker-compose down",
    "docker:logs": "cd .. && docker-compose logs -f app",
    "docker:full-up": "cd .. && docker-compose up -d && echo '전체 스택이 시작되었습니다. 프론트엔드는 npm run dev:local로 실행하세요.'"
  },
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "@headlessui/react": "^1.7.17",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/react-query": "^5.8.4",
    "@tanstack/react-query-devtools": "^5.83.0",
    "axios": "^1.6.2",
    "clsx": "^2.0.0",
    "google-auth-library": "^10.2.1",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.20.1",
    "tailwind-merge": "^2.0.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitejs/plugin-react": "^4.1.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.53.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "vite": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
